{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$ref": "#/$defs/pins",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "hash": {"type":"string","pattern":"^(?!0{64}$)[0-9a-f]{64}$"},
    "positive": {"type":"number","exclusiveMinimum":0},
    "count": {"type":"integer","minimum":0},
    "unavailable": {"type":"object","required":["status","reason"],"additionalProperties":false,"properties":{"status":{"const":"unavailable"},"reason":{"$ref":"#/$defs/text"}}},
    "ref": {"type":"object","required":["path","sha256"],"additionalProperties":false,"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/hash"}}},
    "files": {"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},
    "manifest": {"type":"object","required":["files"],"additionalProperties":false,"properties":{"files":{"$ref":"#/$defs/files"}}},
    "source": {"type":"object","required":["commit","files"],"additionalProperties":false,"properties":{"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"files":{"$ref":"#/$defs/files"}}},
    "input": {"type":"object","required":["workload","media","document","seeds","width_px","height_px","fps_num","fps_den","source_route","output_route"],"additionalProperties":false,"properties":{
      "workload":{"$ref":"#/$defs/ref"},"media":{"$ref":"#/$defs/ref"},"document":{"$ref":"#/$defs/ref"},"seeds":{"type":"array","minItems":1,"items":{"type":"integer"}},
      "width_px":{"type":"integer","minimum":1},"height_px":{"type":"integer","minimum":1},"fps_num":{"type":"integer","minimum":1},"fps_den":{"type":"integer","minimum":1},"source_route":{"$ref":"#/$defs/text"},"output_route":{"$ref":"#/$defs/text"}}},
    "inputs": {"type":"object","minProperties":1,"additionalProperties":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/input"}}},
    "build": {"type":"object","required":["basis","approval","production","binary","harness","rustc","target","profile","lockfile","ffmpeg","test_overlays"],"additionalProperties":false,"properties":{
      "basis":{"enum":["accepted-S3b","S0","43b2625","62a29b1","oracle","candidate"]},"approval":{"$ref":"#/$defs/ref"},"production":{"$ref":"#/$defs/ref"},"binary":{"$ref":"#/$defs/ref"},"harness":{"$ref":"#/$defs/ref"},
      "rustc":{"$ref":"#/$defs/text"},"target":{"$ref":"#/$defs/text"},"profile":{"$ref":"#/$defs/text"},"lockfile":{"$ref":"#/$defs/ref"},"ffmpeg":{"type":"object","required":["version","configuration"],"additionalProperties":false,"properties":{"version":{"$ref":"#/$defs/text"},"configuration":{"$ref":"#/$defs/text"}}},"test_overlays":{"type":"array","items":{"$ref":"#/$defs/ref"}}}},
    "builds": {"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/build"}},
    "approval": {"type":"object","required":["authority","basis","source_sha256","record"],"additionalProperties":false,"properties":{"authority":{"$ref":"#/$defs/text"},"basis":{"$ref":"#/$defs/text"},"source_sha256":{"$ref":"#/$defs/hash"},"record":{"$ref":"#/$defs/ref"}}},
    "host": {"type":"object","required":["identity","class","os","version","architecture","cpu","ram_bytes"],"additionalProperties":false,"properties":{"identity":{"$ref":"#/$defs/text"},"class":{"$ref":"#/$defs/text"},"os":{"enum":["linux","windows"]},"version":{"$ref":"#/$defs/text"},"architecture":{"$ref":"#/$defs/text"},"cpu":{"$ref":"#/$defs/text"},"ram_bytes":{"type":"integer","minimum":1}}},
    "selected": {"type":"object","required":["backend","name","vendor_id","device_id","driver"],"additionalProperties":false,"properties":{"backend":{"enum":["Vulkan","Dx12","Metal","Gl"]},"name":{"$ref":"#/$defs/text"},"vendor_id":{"$ref":"#/$defs/count"},"device_id":{"$ref":"#/$defs/count"},"driver":{"$ref":"#/$defs/text"},"uuid":{"$ref":"#/$defs/text"}}},
    "stack": {"type":"object","required":["runtime","mesa","llvm","icd_manifest_sha256"],"additionalProperties":false,"properties":{"runtime":{"$ref":"#/$defs/text"},"mesa":{"anyOf":[{"$ref":"#/$defs/text"},{"$ref":"#/$defs/unavailable"}]},"llvm":{"anyOf":[{"$ref":"#/$defs/text"},{"$ref":"#/$defs/unavailable"}]},"icd_manifest_sha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"$ref":"#/$defs/unavailable"}]}}},
    "range": {"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/positive"}},
    "envelope": {"type":"object","required":["graphics_mhz","memory_mhz","power_w","pstates"],"additionalProperties":false,"properties":{"graphics_mhz":{"$ref":"#/$defs/range"},"memory_mhz":{"$ref":"#/$defs/range"},"power_w":{"$ref":"#/$defs/range"},"pstates":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^P[0-9]+$"}}}},
    "observation": {"type":"object","required":["timestamp_s","graphics_mhz","memory_mhz","power_w","pstate"],"additionalProperties":false,"properties":{"timestamp_s":{"$ref":"#/$defs/positive"},"graphics_mhz":{"$ref":"#/$defs/positive"},"memory_mhz":{"$ref":"#/$defs/positive"},"power_w":{"$ref":"#/$defs/positive"},"pstate":{"type":"string","pattern":"^P[0-9]+$"},"temperature_c":{"type":"number"}}},
    "reading": {"anyOf":[{"type":"number","minimum":0},{"$ref":"#/$defs/unavailable"}]},
    "default_observation": {"type":"object","required":["timestamp_s","uuid","graphics_mhz","memory_mhz","pstate","power_limit_w","power_draw_w"],"additionalProperties":false,"properties":{"timestamp_s":{"$ref":"#/$defs/positive"},"uuid":{"$ref":"#/$defs/text"},"graphics_mhz":{"$ref":"#/$defs/reading"},"memory_mhz":{"$ref":"#/$defs/reading"},"pstate":{"anyOf":[{"type":"string","pattern":"^P[0-9]+$"},{"$ref":"#/$defs/unavailable"}]},"power_limit_w":{"$ref":"#/$defs/reading"},"power_draw_w":{"$ref":"#/$defs/reading"}}},
    "policy": {"anyOf":[{"type":"object","required":["kind","ruling"],"additionalProperties":false,"properties":{"kind":{"const":"recorded-default"},"ruling":{"$ref":"#/$defs/ref"}}},{"type":"object","required":["kind"],"additionalProperties":false,"properties":{"kind":{"const":"software"}}},{"type":"object","required":["kind","approval","requested","observed"],"additionalProperties":false,"properties":{"kind":{"const":"hardware"},"approval":{"$ref":"#/$defs/ref"},"requested":{"$ref":"#/$defs/envelope"},"observed":{"$ref":"#/$defs/observation"}}}]},
    "policy_approval": {"type":"object","required":["authority","issued_s","requested","record"],"additionalProperties":false,"properties":{"authority":{"const":"Riel"},"issued_s":{"$ref":"#/$defs/positive"},"requested":{"$ref":"#/$defs/envelope"},"record":{"$ref":"#/$defs/ref"}}},
    "gpu": {"type":"object","required":["selected","stack","policy","telemetry"],"additionalProperties":false,"properties":{"selected":{"$ref":"#/$defs/selected"},"stack":{"$ref":"#/$defs/stack"},"policy":{"$ref":"#/$defs/policy"},"telemetry":{"anyOf":[{"type":"array","minItems":1,"items":{"$ref":"#/$defs/observation"}},{"type":"array","minItems":1,"items":{"$ref":"#/$defs/default_observation"}},{"$ref":"#/$defs/unavailable"}]}}},
    "order": {"type":"object","required":["workload","pair","arm","seed"],"additionalProperties":false,"properties":{"workload":{"$ref":"#/$defs/text"},"pair":{"$ref":"#/$defs/count"},"arm":{"$ref":"#/$defs/text"},"seed":{"type":"integer"}}},
    "protocol": {"type":"object","required":["name","poll_ms","sample_ms","runs","order"],"additionalProperties":false,"properties":{"name":{"enum":["P-comp","P-play","P-seek","P-rss","native-display","export","counters","correctness","PERFORMANCE","VM","D13"]},"poll_ms":{"const":5},"sample_ms":{"$ref":"#/$defs/positive"},"runs":{"type":"integer","minimum":1},"order":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/order"}},
      "warm_frames":{"const":30},"measured_frames":{"const":300},"warmup_ms":{"const":2000},"duration_s":{"anyOf":[{"const":60},{"type":"object","minProperties":1,"additionalProperties":{"enum":[60,240]}}]},"export_clips":{"const":24},"frames":{"const":120},"children":{"const":3},"cycles":{"const":30},"B":{"const":16},"reader_cap":{"const":2},"d_bytes":{"type":"integer","minimum":1},"calibration":{"$ref":"#/$defs/ref"},"control":{"anyOf":[{"$ref":"#/$defs/ref"},{"enum":["slowdown","freeze"]}]}}},
    "metric": {"type":"object","required":["decision","unit","scope","limit"],"additionalProperties":false,"properties":{"decision":{"enum":["ratio","equal","zero","invariant","R50_abs","each_le","each_ge","delta","R65","report"]},"unit":{"enum":["ms","byte","percent","fps","count","ratio","sha256","boolean"]},"scope":{"enum":["each_run","paired_median","invariant","report"]},"limit":{"type":"number","minimum":0}}},
    "pins": {"type":"object","required":["schema_version","lane","gate","arms","inputs","builds","host","gpu","protocol","metrics"],"additionalProperties":false,"properties":{"schema_version":{"const":1},"lane":{"enum":["LL","LH","CI-L","CI-W","VM-W"]},"gate":{"$ref":"#/$defs/text"},"arms":{"type":"object","required":["candidate"],"additionalProperties":false,"properties":{"reference":{"$ref":"#/$defs/text"},"candidate":{"$ref":"#/$defs/text"}}},"inputs":{"$ref":"#/$defs/ref"},"builds":{"$ref":"#/$defs/ref"},"host":{"$ref":"#/$defs/ref"},"gpu":{"$ref":"#/$defs/gpu"},"protocol":{"$ref":"#/$defs/protocol"},"metrics":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/metric"}}}},
    "process": {"type":"object","required":["pid","kind","memory_bytes","owned"],"additionalProperties":false,"properties":{"pid":{"type":"integer","minimum":1},"kind":{"enum":["C","G","C+G"]},"memory_bytes":{"$ref":"#/$defs/count"},"owned":{"type":"boolean"}}},
    "preflight": {"type":"object","required":["timestamp_s","uuid","utilization_pct","processes","complete"],"additionalProperties":false,"properties":{"timestamp_s":{"$ref":"#/$defs/positive"},"uuid":{"$ref":"#/$defs/text"},"utilization_pct":{"type":"number","minimum":0,"maximum":100},"processes":{"type":"array","items":{"$ref":"#/$defs/process"}},"complete":{"const":true}}},
    "cpu": {"type":"object","required":["utilization_pct","load_average"],"additionalProperties":false,"properties":{"utilization_pct":{"type":"number","minimum":0},"load_average":{"anyOf":[{"type":"number","minimum":0},{"$ref":"#/$defs/unavailable"}]}}},
    "identity": {"type":"object","required":["binary","production","harness","pins","host"],"additionalProperties":false,"properties":{"binary":{"$ref":"#/$defs/hash"},"production":{"$ref":"#/$defs/hash"},"harness":{"$ref":"#/$defs/hash"},"pins":{"$ref":"#/$defs/hash"},"host":{"$ref":"#/$defs/hash"}}},
    "run": {"type":"object","required":["workload","pair","arm","seed","attempt","supersedes","started_s","ended_s","validity","exit","command","environment","identity","gpu","cpu","preflight","metrics","logs","fingerprint"],"additionalProperties":false,"properties":{
      "workload":{"$ref":"#/$defs/text"},"pair":{"$ref":"#/$defs/count"},"arm":{"$ref":"#/$defs/text"},"seed":{"type":"integer"},"attempt":{"$ref":"#/$defs/count"},"started_s":{"$ref":"#/$defs/positive"},"ended_s":{"$ref":"#/$defs/positive"},"supersedes":{"type":"string"},"validity":{"enum":["valid","invalid_evidence","pending_gpu_busy","environment_limited_at_load"]},"exit":{"type":"integer"},"command":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"environment":{"type":"object","additionalProperties":{"type":"string"}},"identity":{"$ref":"#/$defs/identity"},"gpu":{"$ref":"#/$defs/gpu"},"cpu":{"$ref":"#/$defs/cpu"},"preflight":{"type":"array","items":{"$ref":"#/$defs/preflight"}},"metrics":{"type":"object","minProperties":1,"additionalProperties":{"anyOf":[{"type":"number"},{"type":"boolean"},{"$ref":"#/$defs/hash"}]}},"logs":{"$ref":"#/$defs/files"},"fingerprint":{"$ref":"#/$defs/hash"}}},
    "disposition": {"type":"object","required":["authority","previous_sha256","reason","record"],"additionalProperties":false,"properties":{"authority":{"$ref":"#/$defs/text"},"previous_sha256":{"$ref":"#/$defs/hash"},"reason":{"$ref":"#/$defs/text"},"record":{"$ref":"#/$defs/ref"}}},
    "series": {"type":"object","required":["id","pins"],"additionalProperties":false,"properties":{"id":{"$ref":"#/$defs/text"},"pins":{"$ref":"#/$defs/hash"},"previous":{"$ref":"#/$defs/ref"},"rejection":{"type":"object","required":["exit","reason"],"additionalProperties":false,"properties":{"exit":{"enum":[1,2,75,101]},"reason":{"$ref":"#/$defs/text"},"disposition":{"$ref":"#/$defs/ref"}}}}},
    "status": {"type":"object","required":["lane","gate","runs","series"],"additionalProperties":false,"properties":{"failure":{"type":"object","required":["exit","receipt"],"additionalProperties":false,"properties":{"exit":{"enum":[2,75,101]},"receipt":{"$ref":"#/$defs/ref"}}},"artifacts":{"$ref":"#/$defs/files"},"series":{"$ref":"#/$defs/series"},"lane":{"$ref":"#/$defs/text"},"gate":{"$ref":"#/$defs/text"},"runs":{"type":"array","items":{"$ref":"#/$defs/run"}}}}
  }
}
