 extern "C" {
+
+size_t
+nemo_speech_asr_recognition_options_size(void) {
+    return nemo_speech_asr_recognition_options_default().size;
+}
+
+
+size_t
+nemo_speech_asr_model_config_default(nemo_speech_asr_model_config* out, size_t capacity) {
+    if (out && capacity == sizeof(*out)) {
+        std::memset(out, 0, sizeof(*out));
+        out->size = sizeof(*out);
+    }
+    return sizeof(nemo_speech_asr_model_config);
+}
+
+size_t
+nemo_speech_asr_streaming_config_default(nemo_speech_asr_streaming_config* out, size_t capacity) {
+    if (out && capacity == sizeof(*out)) {
+        std::memset(out, 0, sizeof(*out));
+        out->size = sizeof(*out);
+        out->chunk_size = asr_core::StreamingConfig{}.chunk_size;
+        out->ctc_left_padding = asr_core::StreamingConfig{}.ctc_left_padding;
+        out->ctc_right_padding = asr_core::StreamingConfig{}.ctc_right_padding;
+        out->rnnt_right_context = asr_core::StreamingConfig{}.rnnt_right_context;
+    }
+    return sizeof(nemo_speech_asr_streaming_config);
+}
+
+size_t
+nemo_speech_asr_recognizer_config_default(nemo_speech_asr_recognizer_config* out, size_t capacity) {
+    if (out && capacity == sizeof(*out)) {
+        std::memset(out, 0, sizeof(*out));
+        out->size = sizeof(*out);
+        out->log_status = true;
+    }
+    return sizeof(nemo_speech_asr_recognizer_config);
+}
