+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+mod bootstrap;
+#[cfg(target_os = "linux")]
+mod bus;
+#[cfg(target_os = "linux")]
+mod service;
+
+fn main() {
+    #[cfg(target_os = "linux")]
+    if service::run().is_err() {
+        std::process::exit(125);
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        // The scope supervisor is Linux-only. Slice 1b retains Windows' native path.
+        std::process::exit(125);
+    }
+}
diff --git 1/crates/kinewright-media-supervisor/src/service.rs 2/crates/kinewright-media-supervisor/src/service.rs
new file mode 100644
index 00000000..56cb06dd
--- /dev/null
+++ 2/crates/kinewright-media-supervisor/src/service.rs
@@ -0,0 +1,318 @@
+use crate::bus::{self, Bus};
+use kinewright_job_sys::{Cgroup, ProcessHandle, media_scope as native};
+use kinewright_media_ipc::{
+    Frame, MediaSandboxError as Error, Message, ProbeSession, ScopeUnavailableReason, write_frame,
+};
+use std::{
+    io,
+    net::Shutdown,
+    os::unix::net::UnixStream,
+    time::{Duration, Instant},
+};
+
+struct Record {
+    id: u32,
+    unit: String,
+    process: ProcessHandle,
+    memory: u64,
+    group: Option<Cgroup>,
+}
+struct Service {
+    app: u32,
+    generation: u64,
+    own_start: u64,
+    bus: Option<Bus>,
+    records: Vec<Record>,
+    next: u32,
+}
+impl Service {
+    fn create(&mut self, pid: u32, memory: u64) -> Message {
+        if pid == self.app || pid == std::process::id() {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        }
+        if self.records.len() >= 2 {
+            return Message::Failed {
+                error: Error::ResourceLimit,
+            };
+        }
+        if !(64 * 1024 * 1024..=2 * 1024 * 1024 * 1024).contains(&memory) {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        }
+        if self.bus.is_none() {
+            return Message::ScopeUnavailable {
+                scope: None,
+                reason: ScopeUnavailableReason::NoUserManager,
+            };
+        }
+        let Ok(process) = native::child(self.app, pid) else {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        };
+        if self
+            .records
+            .iter()
+            .any(|record| record.process.pid() == pid)
+        {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        }
+        let Some(id) = self.next.checked_add(1) else {
+            return Message::Failed {
+                error: Error::ResourceLimit,
+            };
+        };
+        self.next = id;
+        self.records.push(Record {
+            id,
+            unit: format!(
+                "kinewright-media-{}-{}-{}-{}-{id}.scope",
+                self.app,
+                std::process::id(),
+                self.own_start,
+                self.generation
+            ),
+            process,
+            memory,
+            group: None,
+        });
+        let record = &self.records[self.records.len() - 1];
+        let result = self.bus.as_ref().ok_or(()).and_then(|bus| {
+            bus.start(&record.unit, &record.process, memory)
+                .map_err(|_| ())
+        });
+        if result.is_err() {
+            // The bus may have created the unit even when its reply was lost.
+            // Keep the bounded record and give the host its cleanup identity.
+            Message::ScopeCreateFailed {
+                scope: id,
+                error: Error::SandboxUnavailable,
+            }
+        } else {
+            Message::ScopeCreated { scope: id }
+        }
+    }
+    fn verify(&mut self, id: u32) -> Message {
+        let Some(index) = self.records.iter().position(|record| record.id == id) else {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        };
+        let deadline = Instant::now() + Duration::from_secs(2);
+        let result = loop {
+            match self.verify_record(index) {
+                Err(error)
+                    if error.kind() == io::ErrorKind::WouldBlock && Instant::now() < deadline =>
+                {
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                result => break result,
+            }
+        };
+        match result {
+            Ok(()) => Message::ScopeVerified {
+                scope: id,
+                starttime: self.records[index].process.start(),
+            },
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Message::ScopeUnavailable {
+                scope: Some(id),
+                reason: ScopeUnavailableReason::ControllersUnavailable,
+            },
+            Err(error) => {
+                eprintln!("MS2_SCOPE_VERIFY {id}: {error}");
+                Message::Failed {
+                    error: Error::SandboxUnavailable,
+                }
+            }
+        }
+    }
+    fn verify_record(&mut self, index: usize) -> io::Result<()> {
+        let bus = self
+            .bus
+            .as_ref()
+            .ok_or_else(|| io::Error::other("user manager unavailable"))?;
+        let record = &mut self.records[index];
+        native::verify_child(self.app, &record.process)?;
+        let path = bus.unit(&record.unit).map_err(io::Error::other)?;
+        if !bus.active(&path).map_err(io::Error::other)? {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "scope start pending",
+            ));
+        }
+        if !bus
+            .verify_controls(&path, record.memory)
+            .map_err(io::Error::other)?
+        {
+            return Err(io::Error::other(
+                "scope not active or configured controls mismatch",
+            ));
+        }
+        let group_path = native::checked_group(&bus.group(&path).map_err(io::Error::other)?)?;
+        native::outside(self.app, &group_path)?;
+        if native::membership(record.process.pid())? != group_path {
+            return Err(io::Error::other("scope membership mismatch"));
+        }
+        if let Some(retained) = record.group.as_ref() {
+            if retained.path() != group_path {
+                return Err(io::Error::other("scope cgroup changed"));
+            }
+        } else {
+            record.group = Some(Cgroup::open(&group_path)?);
+        }
+        let group = record
+            .group
+            .as_ref()
+            .ok_or_else(|| io::Error::other("missing retained cgroup"))?;
+        native::verify_controls(group, record.memory)?;
+        native::verify_child(self.app, &record.process)
+    }
+    fn stop_record(&mut self, index: usize) -> io::Result<bool> {
+        let record = &mut self.records[index];
+        let bus = self
+            .bus
+            .as_ref()
+            .ok_or_else(|| io::Error::other("user manager unavailable"))?;
+        let stop = bus.stop(&record.unit);
+        if record.group.is_none() {
+            match bus.unit(&record.unit) {
+                Ok(path) => {
+                    let path = native::checked_group(&bus.group(&path).map_err(io::Error::other)?)?;
+                    native::outside(self.app, &path)?;
+                    record.group = Some(Cgroup::open(&path)?);
+                }
+                Err(error) if bus::absent(&error) => {
+                    stop.map_err(io::Error::other)?;
+                    return Ok(true);
+                }
+                Err(error) => return Err(io::Error::other(error)),
+            }
+        }
+        let group = record
+            .group
+            .as_mut()
+            .ok_or_else(|| io::Error::other("missing retained cgroup"))?;
+        if !group.empty()? {
+            return Ok(false);
+        }
+        // Native emptiness is the release condition. The generated unit is also
+        // stopped/reset; CollectMode makes an empty failed unit collectible.
+        stop.map_err(io::Error::other)?;
+        bus.reset(&record.unit).map_err(io::Error::other)?;
+        Ok(true)
+    }
+    fn stop(&mut self, id: u32) -> Message {
+        let Some(index) = self.records.iter().position(|record| record.id == id) else {
+            return Message::Failed {
+                error: Error::ProtocolViolation,
+            };
+        };
+        let deadline = Instant::now() + Duration::from_secs(3);
+        loop {
+            match self.stop_record(index) {
+                Ok(true) => {
+                    self.records.remove(index);
+                    return Message::ScopeStopped { scope: id };
+                }
+                Err(_) => {
+                    return Message::Failed {
+                        error: Error::SandboxUnavailable,
+                    };
+                }
+                Ok(false) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(10))
+                }
+                Ok(false) => {
+                    return Message::Failed {
+                        error: Error::TimedOut,
+                    };
+                }
+            }
+        }
+    }
+    fn shutdown(&mut self) {
+        // Keep ownership until every native scope is empty, even when the app
+        // socket disappears. This loop admits no new work and creates no units.
+        while !self.records.is_empty() {
+            let mut retry = false;
+            for index in (0..self.records.len()).rev() {
+                if matches!(self.stop_record(index), Ok(true)) {
+                    self.records.remove(index);
+                } else {
+                    retry = true;
+                }
+            }
+            if retry {
+                self.bus = Bus::connect().ok();
+                std::thread::sleep(Duration::from_millis(100));
+            }
+        }
+    }
+    fn serve(&mut self, socket: &mut UnixStream) -> io::Result<()> {
+        let initial = if self.bus.is_some() {
+            Message::Ready {}
+        } else {
+            Message::ScopeUnavailable {
+                scope: None,
+                reason: ScopeUnavailableReason::NoUserManager,
+            }
+        };
+        write_frame(
+            socket,
+            &Frame {
+                request: 1,
+                generation: self.generation,
+                message: initial,
+            },
+        )?;
+        let mut last = 1;
+        let mut traffic = ProbeSession::new(1, self.generation);
+        loop {
+            // Charge framing before allocation; lifecycle sequencing is separate
+            // from the probe state machine and never accepts media commands.
+            let frame = traffic.read(socket, Instant::now())?;
+            if frame.generation != self.generation || frame.request <= last {
+                return Err(io::Error::other("stale lifecycle request"));
+            }
+            last = frame.request;
+            let message = match frame.message {
+                Message::CreateScope { pid, memory_bytes } => self.create(pid, memory_bytes),
+                Message::VerifyScope { scope } => self.verify(scope),
+                Message::StopScope { scope } => self.stop(scope),
+                _ => return Err(io::Error::other("non-lifecycle supervisor command")),
+            };
+            write_frame(
+                socket,
+                &Frame {
+                    request: frame.request,
+                    generation: self.generation,
+                    message,
+                },
+            )?;
+        }
+    }
+}
+pub fn run() -> io::Result<()> {
+    let (app, generation, mut socket) = crate::bootstrap::input()?;
+    let own_start = ProcessHandle::open(std::process::id())?.start();
+    let mut service = Service {
+        app,
+        generation,
+        own_start,
+        bus: Bus::connect().ok(),
+        records: Vec::with_capacity(2),
+        next: 0,
+    };
+    let result = service.serve(&mut socket);
+    let _ = socket.shutdown(Shutdown::Both);
+    service.shutdown();
+    match result {
+        Err(error) if error.kind() == io::ErrorKind::UnexpectedEof => Ok(()),
+        other => other,
+    }
+}
diff --git 1/crates/kinewright-media-supervisor/tests/scope_native.rs 2/crates/kinewright-media-supervisor/tests/scope_native.rs
new file mode 100644
index 00000000..3ff7e868
--- /dev/null
+++ 2/crates/kinewright-media-supervisor/tests/scope_native.rs
@@ -0,0 +1,341 @@
+#![cfg(target_os = "linux")]
+#![allow(unsafe_code)]
+use kinewright_job_sys::{ProcessHandle, media_scope};
+use kinewright_media_ipc::{
+    Frame, MediaSandboxError, Message, ScopeUnavailableReason, read_frame, write_frame,
+};
+use std::{
+    fs,
+    io::{Read, Write},
+    net::Shutdown,
+    os::{fd::AsRawFd, unix::net::UnixStream},
+    path::PathBuf,
+    process::{Child, Command, Stdio},
+    sync::atomic::{AtomicU64, Ordering},
+    time::{Duration, Instant},
+};
+static NEXT: AtomicU64 = AtomicU64::new(1);
+const GENERATION: u64 = 719;
+struct ManagedChild {
+    child: Child,
+    reaped: bool,
+    marker: PathBuf,
+}
+impl ManagedChild {
+    fn blocked() -> Self {
+        let marker = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../target/ms2-s1a")
+            .join(format!(
+                "scope-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+        let child = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "blocked_child_fixture", "--nocapture"])
+            .env_clear()
+            .env("KW_SCOPE_BLOCK", "1")
+            .env("KW_SCOPE_MARKER", &marker)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        Self {
+            child,
+            reaped: false,
+            marker,
+        }
+    }
+    fn kill(&mut self) {
+        if !self.reaped {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+            self.reaped = true;
+        }
+    }
+    fn release(&mut self) {
+        self.child.stdin.take().unwrap().write_all(&[1]).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        loop {
+            if let Some(status) = self.child.try_wait().unwrap() {
+                assert!(status.success());
+                self.reaped = true;
+                break;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "blocked scope fixture did not finish"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        assert!(
+            self.marker.exists(),
+            "fixture never crossed its release barrier"
+        );
+    }
+}
+impl Drop for ManagedChild {
+    fn drop(&mut self) {
+        self.kill();
+        let _ = fs::remove_file(&self.marker);
+    }
+}
+#[test]
+fn blocked_child_fixture() {
+    if std::env::var_os("KW_SCOPE_BLOCK").is_none() {
+        return;
+    }
+    let mut token = [0];
+    std::io::stdin().read_exact(&mut token).unwrap();
+    assert_eq!(token, [1]);
+    // The parent observes only an empty marker's existence, not in-place contents.
+    fs::write(std::env::var_os("KW_SCOPE_MARKER").unwrap(), b"").unwrap();
+}
+struct Supervisor {
+    child: Child,
+    socket: UnixStream,
+    request: u32,
+    records: Vec<u32>,
+    start: u64,
+    reaped: bool,
+}
+impl Supervisor {
+    fn start(manager: bool) -> (Self, Message) {
+        let (socket, inherited) = media_scope::socketpair().unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_secs(6)))
+            .unwrap();
+        socket
+            .set_write_timeout(Some(Duration::from_secs(6)))
+            .unwrap();
+        let stderr_path = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../target/ms2-s1a")
+            .join(format!(
+                "supervisor-{}-{}.log",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+        let stderr = fs::File::create(stderr_path).unwrap();
+        let mut command = Command::new(env!("CARGO_BIN_EXE_kinewright-media-supervisor"));
+        command
+            .args([std::process::id().to_string(), GENERATION.to_string()])
+            .env_clear()
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::from(stderr));
+        if manager {
+            let address = media_scope::session_bus_address();
+            command.env("DBUS_SESSION_BUS_ADDRESS", address);
+        }
+        // SAFETY: inherited stays owned through spawn; the audited wrapper
+        // creates a child-only copy at the reserved supervisor endpoint.
+        unsafe {
+            media_scope::inherit_socket(&mut command, inherited.as_raw_fd());
+        }
+        let child = command.spawn().unwrap();
+        drop(inherited);
+        let start = ProcessHandle::open(child.id()).unwrap().start();
+        let mut supervisor = Self {
+            child,
+            socket,
+            request: 1,
+            records: vec![],
+            start,
+            reaped: false,
+        };
+        let first = read_frame(&mut supervisor.socket).unwrap();
+        assert_eq!((first.request, first.generation), (1, GENERATION));
+        (supervisor, first.message)
+    }
+    fn rpc(&mut self, message: Message) -> Message {
+        self.request += 1;
+        write_frame(
+            &mut self.socket,
+            &Frame {
+                request: self.request,
+                generation: GENERATION,
+                message,
+            },
+        )
+        .unwrap();
+        let frame = read_frame(&mut self.socket).unwrap();
+        assert_eq!(
+            (frame.request, frame.generation),
+            (self.request, GENERATION)
+        );
+        frame.message
+    }
+    fn create(&mut self, child: &ManagedChild) -> u32 {
+        let message = self.rpc(Message::CreateScope {
+            pid: child.child.id(),
+            memory_bytes: 64 * 1024 * 1024,
+        });
+        match message {
+            Message::ScopeCreated { scope } => {
+                self.records.push(scope);
+                scope
+            }
+            Message::ScopeCreateFailed { scope, error } => {
+                self.records.push(scope);
+                panic!("scope create failed {error:?}");
+            }
+            other => panic!("native primary scope gate failed: {other:?}"),
+        }
+    }
+    fn stop(&mut self, scope: u32) {
+        assert!(
+            matches!(self.rpc(Message::StopScope{scope}),Message::ScopeStopped{scope:actual} if actual==scope)
+        );
+        self.records.retain(|value| *value != scope);
+    }
+    fn unit(&self, id: u32) -> String {
+        format!(
+            "kinewright-media-{}-{}-{}-{}-{id}.scope",
+            std::process::id(),
+            self.child.id(),
+            self.start,
+            GENERATION
+        )
+    }
+    fn finish(&mut self) {
+        let _ = self.socket.shutdown(Shutdown::Both);
+        let deadline = Instant::now() + Duration::from_secs(6);
+        loop {
+            if let Some(status) = self.child.try_wait().unwrap() {
+                assert!(status.success(), "{status}");
+                self.reaped = true;
+                break;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "supervisor did not finish cleanup"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+}
+impl Drop for Supervisor {
+    fn drop(&mut self) {
+        let _ = self.socket.shutdown(Shutdown::Both);
+        let deadline = Instant::now() + Duration::from_secs(6);
+        while !self.reaped && Instant::now() < deadline {
+            if self.child.try_wait().ok().flatten().is_some() {
+                self.reaped = true;
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        if !self.reaped {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+        // Exception-path cleanup names only units generated by this supervisor.
+        // The production implementation never invokes systemctl or systemd-run.
+        for id in &self.records {
+            let unit = self.unit(*id);
+            let _ = Command::new("systemctl")
+                .args(["--user", "stop", &unit])
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .status();
+            let _ = Command::new("systemctl")
+                .args(["--user", "reset-failed", &unit])
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .status();
+        }
+    }
+}
+#[test]
+fn native_scope_limits_join_before_release_and_supervisor_stays_outside() {
+    let (mut supervisor, ready) = Supervisor::start(true);
+    assert!(matches!(ready, Message::Ready {}), "{ready:?}");
+    let mut child = ManagedChild::blocked();
+    let scope = supervisor.create(&child);
+    assert!(
+        !child.marker.exists(),
+        "child ran before verified resource join"
+    );
+    let reply = supervisor.rpc(Message::VerifyScope { scope });
+    assert!(
+        matches!(reply,Message::ScopeVerified{scope:actual,starttime} if actual==scope && starttime==ProcessHandle::open(child.child.id()).unwrap().start()),
+        "{reply:?}"
+    );
+    let group = media_scope::membership(child.child.id()).unwrap();
+    assert_ne!(
+        media_scope::membership(supervisor.child.id()).unwrap(),
+        group
+    );
+    assert_ne!(media_scope::membership(std::process::id()).unwrap(), group);
+    let native = kinewright_job_sys::Cgroup::open(&group).unwrap();
+    media_scope::verify_controls(&native, 64 * 1024 * 1024).unwrap();
+    child.release();
+    supervisor.stop(scope);
+    supervisor.finish();
+}
+#[test]
+fn native_scope_records_are_bounded_and_self_or_stale_requests_are_refused() {
+    let (mut supervisor, ready) = Supervisor::start(true);
+    assert!(matches!(ready, Message::Ready {}), "{ready:?}");
+    for pid in [std::process::id(), supervisor.child.id()] {
+        assert!(matches!(
+            supervisor.rpc(Message::CreateScope {
+                pid,
+                memory_bytes: 64 * 1024 * 1024
+            }),
+            Message::Failed {
+                error: MediaSandboxError::ProtocolViolation
+            }
+        ));
+    }
+    let mut first = ManagedChild::blocked();
+    let mut second = ManagedChild::blocked();
+    let third = ManagedChild::blocked();
+    let a = supervisor.create(&first);
+    let b = supervisor.create(&second);
+    assert!(matches!(
+        supervisor.rpc(Message::CreateScope {
+            pid: third.child.id(),
+            memory_bytes: 64 * 1024 * 1024
+        }),
+        Message::Failed {
+            error: MediaSandboxError::ResourceLimit
+        }
+    ));
+    assert!(matches!(
+        supervisor.rpc(Message::VerifyScope { scope: u32::MAX }),
+        Message::Failed {
+            error: MediaSandboxError::ProtocolViolation
+        }
+    ));
+    first.kill();
+    second.kill();
+    supervisor.stop(a);
+    supervisor.stop(b);
+    supervisor.finish();
+}
+#[test]
+fn missing_user_manager_is_typed_and_creates_no_scope() {
+    let (mut supervisor, ready) = Supervisor::start(false);
+    assert!(matches!(
+        ready,
+        Message::ScopeUnavailable {
+            scope: None,
+            reason: ScopeUnavailableReason::NoUserManager
+        }
+    ));
+    let child = ManagedChild::blocked();
+    assert!(matches!(
+        supervisor.rpc(Message::CreateScope {
+            pid: child.child.id(),
+            memory_bytes: 64 * 1024 * 1024
+        }),
+        Message::ScopeUnavailable {
+            scope: None,
+            reason: ScopeUnavailableReason::NoUserManager
+        }
+    ));
+    supervisor.finish();
+}
