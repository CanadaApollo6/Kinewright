index 00000000..1c26dfac
--- /dev/null
+++ 2/crates/kinewright-media-helper/src/avio.rs
@@ -0,0 +1,378 @@
+//! Audited FFmpeg FFI. The only input capability is the retained source descriptor.
+#![allow(unsafe_code)]
+use ffmpeg_next::{self as ffmpeg, ffi};
+use kinewright_media_ipc::MediaSandboxError as Error;
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom},
+    ptr,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+const IO_LIMIT: u64 = 64 * 1024 * 1024;
+struct Cursor {
+    file: File,
+    length: u64,
+    read: u64,
+    cancel: Arc<AtomicBool>,
+    failure: Option<Error>,
+}
+pub struct Input {
+    pub format: ffmpeg::format::context::Input,
+    _avio: Avio,
+    pub header: Vec<u8>,
+}
+type Avio = kinewright_media_input::owned_io::Avio<Cursor>;
+impl Input {
+    pub fn open(
+        mut file: File,
+        length: u64,
+        budget: u64,
+        cancel: Arc<AtomicBool>,
+    ) -> Result<Self, Error> {
+        if length > i64::MAX.cast_unsigned() {
+            return Err(Error::UnsupportedMedia);
+        }
+        let mut header = vec![0; 65536];
+        let count = file
+            .read(&mut header)
+            .map_err(|_| Error::UnsupportedMedia)?;
+        header.truncate(count);
+        file.seek(SeekFrom::Start(0))
+            .map_err(|_| Error::UnsupportedMedia)?;
+        let cursor = Box::new(Cursor {
+            file,
+            length,
+            read: 0,
+            cancel,
+            failure: None,
+        });
+        // SAFETY: Input declares format before AVIO, so native input teardown
+        // finishes before its stable cursor and buffer are released.
+        let (mut format, avio) = unsafe { Avio::open(*cursor) }?;
+        // SAFETY: format is the exclusive owner of its live AVFormatContext.
+        unsafe {
+            (*format.as_mut_ptr()).max_analyze_duration = 5_000_000;
+            if (*format.as_ptr()).ctx_flags & ffi::AVFMTCTX_NOHEADER != 0 {
+                if !matches!(format.format().name(), "png_pipe" | "jpeg_pipe")
+                    || format.nb_streams() != 1
+                {
+                    return Err(Error::UnsupportedMedia);
+                }
+                let (w, h) = still_dimensions(&header).ok_or(Error::UnsupportedMedia)?;
+                let mut parameters = format
+                    .stream(0)
+                    .ok_or(Error::UnsupportedMedia)?
+                    .parameters();
+                (*parameters.as_mut_ptr()).width =
+                    i32::try_from(w).map_err(|_| Error::UnsupportedMedia)?;
+                (*parameters.as_mut_ptr()).height =
+                    i32::try_from(h).map_err(|_| Error::UnsupportedMedia)?;
+            }
+            (*format.as_mut_ptr()).max_streams =
+                i32::try_from(format.nb_streams()).map_err(|_| Error::UnsupportedMedia)?;
+            let input = Self {
+                format,
+                _avio: avio,
+                header,
+            };
+            for stream in input.format.streams() {
+                allocation(&stream.parameters(), budget)?;
+            }
+            Ok(input)
+        }
+    }
+    pub fn find_stream_info(&mut self, budget: u64) -> Result<(), Error> {
+        let mut options = vec![ptr::null_mut(); self.format.nb_streams() as usize];
+        // SAFETY: options has one writable dictionary slot per bounded stream;
+        // FFmpeg cannot add streams beyond the frozen max_streams limit.
+        unsafe {
+            for (option, stream) in options.iter_mut().zip(self.format.streams()) {
+                let bound = allocation(&stream.parameters(), budget)?;
+                ffi::av_dict_set(option, c"threads".as_ptr(), c"1".as_ptr(), 0);
+                ffi::av_dict_set_int(option, c"max_pixels".as_ptr(), bound.pixels, 0);
+                ffi::av_dict_set_int(option, c"max_samples".as_ptr(), 65536, 0);
+            }
+            let result =
+                ffi::avformat_find_stream_info(self.format.as_mut_ptr(), options.as_mut_ptr());
+            for option in &mut options {
+                ffi::av_dict_free(option);
+            }
+            if result < 0 {
+                return Err(Error::UnsupportedMedia);
+            }
+        }
+        self._avio.check()
+    }
+    pub fn check(&mut self) -> Result<(), Error> {
+        self._avio.check()
+    }
+    pub fn decoder_context(
+        &self,
+        parameters: ffmpeg::codec::Parameters,
+        budget: u64,
+    ) -> Result<ffmpeg::codec::context::Context, Error> {
+        let bound = allocation(&parameters, budget)?;
+        let mut context = ffmpeg::codec::context::Context::from_parameters(parameters)
+            .map_err(|_| Error::UnsupportedMedia)?;
+        context.set_threading(ffmpeg::codec::threading::Config {
+            count: 1,
+            kind: ffmpeg::codec::threading::Type::None,
+        });
+        // SAFETY: context owns a live AVCodecContext; these limits precede decoder open.
+        unsafe {
+            (*context.as_mut_ptr()).max_pixels = bound.pixels;
+            (*context.as_mut_ptr()).max_samples = 65536;
+        }
+        Ok(context)
+    }
+    pub fn packet(&mut self, index: usize) -> Result<Option<ffmpeg::Packet>, Error> {
+        loop {
+            let mut packet = ffmpeg::Packet::empty();
+            self._avio.check()?;
+            let result = packet.read(&mut self.format);
+            self._avio.check()?;
+            match result {
+                Ok(()) if packet.stream() == index => return Ok(Some(packet)),
+                Ok(()) => {}
+                Err(ffmpeg::Error::Eof) => return Ok(None),
+                Err(_) => return Err(Error::UnsupportedMedia),
+            }
+        }
+    }
+    pub fn check_frame(
+        &self,
+        index: usize,
+        decoder: &ffmpeg::decoder::Video,
+        frame: &ffmpeg::frame::Video,
+        budget: u64,
+    ) -> Result<(), Error> {
+        let stream = self.format.stream(index).ok_or(Error::UnsupportedMedia)?;
+        let bound = allocation(&stream.parameters(), budget)?;
+        // SAFETY: decoder owns a live context throughout this post-decode check.
+        let references = unsafe { (*decoder.as_ptr()).refs };
+        if u64::try_from(references).is_ok_and(|references| references > bound.references)
+            || u64::from(frame.width()) * u64::from(frame.height()) > bound.pixels.cast_unsigned()
+            || frame.width() != decoder.width()
+            || frame.height() != decoder.height()
+        {
+            return Err(Error::UnsupportedMedia);
+        }
+        Ok(())
+    }
+}
+struct Bound {
+    pixels: i64,
+    references: u64,
+}
+fn allocation(parameters: &ffmpeg::codec::Parameters, budget: u64) -> Result<Bound, Error> {
+    // SAFETY: the parameters owner keeps this AVCodecParameters alive throughout inspection.
+    let p = unsafe { &*parameters.as_ptr() };
+    if p.codec_type == ffi::AVMediaType::AVMEDIA_TYPE_AUDIO {
+        if !(1..=32).contains(&p.ch_layout.nb_channels) || !(1..=384000).contains(&p.sample_rate) {
+            return Err(Error::UnsupportedMedia);
+        }
+        return Ok(Bound {
+            pixels: 0,
+            references: 0,
+        });
+    }
+    if p.codec_type != ffi::AVMediaType::AVMEDIA_TYPE_VIDEO
+        || !(1..=8192).contains(&p.width)
+        || !(1..=8192).contains(&p.height)
+    {
+        return Err(Error::UnsupportedMedia);
+    }
+    let pixels = i64::from(p.width) * i64::from(p.height);
+    if pixels.cast_unsigned() * 8 > 128 * 1024 * 1024 {
+        return Err(Error::UnsupportedMedia);
+    }
+    // Headers cannot increase the hard native reservation. Unknown pixel formats
+    // use the largest supported packed sample footprint until stream-info resolves it.
+    let mut bytes_per_pixel = match p.codec_id {
+        ffi::AVCodecID::AV_CODEC_ID_H264
+        | ffi::AVCodecID::AV_CODEC_ID_HEVC
+        | ffi::AVCodecID::AV_CODEC_ID_AV1
+        | ffi::AVCodecID::AV_CODEC_ID_VP9
+        | ffi::AVCodecID::AV_CODEC_ID_VP8 => 8,
+        _ => 16,
+    };
+    if let Some(bytes) = storage_bytes(p.format) {
+        bytes_per_pixel = bytes;
+    }
+    let dpb = match p.codec_id {
+        ffi::AVCodecID::AV_CODEC_ID_H264 => {
+            let max_mbs = match p.level {
+                10 => 396,
+                11 => 900,
+                12 | 13 | 20 => 2376,
+                21 => 4752,
+                22 | 30 => 8100,
+                31 => 18000,
+                32 => 20480,
+                40 | 41 => 32768,
+                42 => 34816,
+                50 => 110400,
+                51 | 52 => 184320,
+                _ => usize::MAX,
+            };
+            let picture_mbs = u64::try_from(p.width).unwrap_or(8192).div_ceil(16)
+                * u64::try_from(p.height).unwrap_or(8192).div_ceil(16);
+            let references = (max_mbs as u64 / picture_mbs).min(16);
+            if references == 0 {
+                return Err(Error::UnsupportedMedia);
+            }
+            references
+        }
+        ffi::AVCodecID::AV_CODEC_ID_HEVC => {
+            let max_luma = match p.level {
+                30 => 36864,
+                60 => 122880,
+                63 => 245760,
+                90 => 552960,
+                93 => 983040,
+                120 | 123 => 2228224,
+                150 | 153 | 156 => 8912896,
+                180 | 183 | 186 => 35651584,
+                _ => i64::MAX,
+            };
+            if pixels <= max_luma / 4 {
+                16
+            } else if pixels <= max_luma / 2 {
+                12
+            } else if pixels <= max_luma / 4 * 3 {
+                8
+            } else {
+                6
+            }
+        }
+        ffi::AVCodecID::AV_CODEC_ID_AV1 | ffi::AVCodecID::AV_CODEC_ID_VP9 => 8,
+        _ => 1,
+    };
+    let frame = (u64::try_from(p.width)
+        .map_err(|_| Error::UnsupportedMedia)?
+        .div_ceil(128)
+        * 128
+        + 256)
+        * (u64::try_from(p.height)
+            .map_err(|_| Error::UnsupportedMedia)?
+            .div_ceil(128)
+            * 128
+            + 256)
+        * bytes_per_pixel;
+    // One decoder thread, no scaler, one accepted frame plus native scratch.
+    if frame
+        .checked_mul(dpb + 3)
+        .is_none_or(|bytes| bytes > budget)
+    {
+        return Err(Error::ResourceLimit);
+    }
+    Ok(Bound {
+        pixels,
+        references: dpb,
+    })
+}
+fn still_dimensions(header: &[u8]) -> Option<(u32, u32)> {
+    if header.starts_with(b"\x89PNG\r\n\x1a\n") && header.get(12..16)? == b"IHDR" {
+        return Some((
+            u32::from_be_bytes(header.get(16..20)?.try_into().ok()?),
+            u32::from_be_bytes(header.get(20..24)?.try_into().ok()?),
+        ));
+    }
+    if !header.starts_with(&[0xff, 0xd8]) {
+        return None;
+    }
+    let mut offset = 2;
+    while header.get(offset) == Some(&0xff) {
+        while header.get(offset) == Some(&0xff) {
+            offset += 1;
+        }
+        let marker = *header.get(offset)?;
+        offset += 1;
+        let length = usize::from(u16::from_be_bytes(
+            header.get(offset..offset + 2)?.try_into().ok()?,
+        ));
+        if length < 2 {
+            return None;
+        }
+        if matches!(marker, 0xc0..=0xc3 | 0xc5..=0xc7 | 0xc9..=0xcb | 0xcd..=0xcf) {
+            let height = u16::from_be_bytes(header.get(offset + 3..offset + 5)?.try_into().ok()?);
+            let width = u16::from_be_bytes(header.get(offset + 5..offset + 7)?.try_into().ok()?);
+            return Some((u32::from(width), u32::from(height)));
+        }
+        offset = offset.checked_add(length)?;
+    }
+    None
+}
+
+impl kinewright_media_input::owned_io::Cursor for Cursor {
+    type Error = Error;
+    fn read(&mut self, output: &mut [u8]) -> Result<usize, Self::Error> {
+        self.check()?;
+        if self.read >= IO_LIMIT {
+            self.failure = Some(Error::ResourceLimit);
+            return Err(Error::ResourceLimit);
+        }
+        let count = self
+            .file
+            .read(output)
+            .map_err(|_| Error::UnsupportedMedia)?;
+        self.read += count as u64;
+        Ok(count)
+    }
+    fn seek(&mut self, position: SeekFrom) -> Result<u64, Self::Error> {
+        self.check()?;
+        self.file
+            .seek(position)
+            .map_err(|_| Error::UnsupportedMedia)
+    }
+    fn size(&mut self) -> Result<u64, Self::Error> {
+        Ok(self.length)
+    }
+    fn check(&mut self) -> Result<(), Self::Error> {
+        if self.cancel.load(Ordering::Acquire) {
+            return Err(Error::Cancelled);
+        }
+        self.failure.map_or(Ok(()), Err)
+    }
+    fn temporarily_unavailable(_error: &Self::Error) -> bool {
+        false
+    }
+    fn capacity(&mut self, _message: &str) -> Self::Error {
+        Error::ResourceLimit
+    }
+    fn decoder(&mut self, _message: String) -> Self::Error {
+        Error::UnsupportedMedia
+    }
+    fn unavailable(&mut self, _message: &str) -> Self::Error {
+        self.failure = Some(Error::UnsupportedMedia);
+        Error::UnsupportedMedia
+    }
+}
+
+fn storage_bytes(format: i32) -> Option<u64> {
+    if format < 0 {
+        return None;
+    }
+    // SAFETY: this walks FFmpeg's immutable descriptor table, never constructs
+    // a Rust enum from an untrusted numeric pixel-format header.
+    unsafe {
+        let mut descriptor = ptr::null();
+        for _ in 0..512 {
+            descriptor = ffi::av_pix_fmt_desc_next(descriptor);
+            if descriptor.is_null() {
+                return None;
+            }
+            if ffi::av_pix_fmt_desc_get_id(descriptor) as i32 == format {
+                return u64::try_from(ffi::av_get_padded_bits_per_pixel(descriptor))
+                    .ok()
+                    .filter(|bits| *bits > 0)
+                    .map(|bits| bits.div_ceil(8));
+            }
+        }
+    }
+    None
+}
diff --git 1/crates/kinewright-media-helper/src/bootstrap.rs 2/crates/kinewright-media-helper/src/bootstrap.rs
new file mode 100644
index 00000000..854dac24
--- /dev/null
+++ 2/crates/kinewright-media-helper/src/bootstrap.rs
@@ -0,0 +1,190 @@
+//! Audited exec/bootstrap FFI and ownership of inherited descriptors.
+use kinewright_job_sys::media_boundary::{self as boundary, Mode};
+use kinewright_media_ipc::{Frame, Message, read_frame, write_frame};
+use std::{
+    fs::File,
+    io::{self, Read},
+    path::PathBuf,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+fn inherited(fd: i32) -> File {
+    // SAFETY: this separately exec'd binary takes each reserved inherited fd once,
+    // after fork has given the shim and payload independent descriptor ownership.
+    unsafe { boundary::inherited_file(fd) }
+}
+fn expect(reader: &mut impl Read, expected: fn(&Message) -> bool) -> io::Result<Frame> {
+    let frame = read_frame(reader)?;
+    if !expected(&frame.message) {
+        return Err(io::Error::other("media bootstrap sequence"));
+    }
+    Ok(frame)
+}
+fn send(writer: &mut File, request: u32, generation: u64, message: Message) -> io::Result<()> {
+    write_frame(
+        writer,
+        &Frame {
+            request,
+            generation,
+            message,
+        },
+    )
+}
+pub fn run() -> io::Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 4 {
+        return Err(io::Error::other("media bootstrap arguments"));
+    }
+    let app_pid = args[0].parse().map_err(io::Error::other)?;
+    let root = PathBuf::from(&args[1]);
+    let mode = match args[2].as_str() {
+        "scope" => Mode::Scope,
+        "degraded" => Mode::Degraded,
+        _ => return Err(io::Error::other("media mode")),
+    };
+    // This is an admitted host limit. Slice 1a measurements freeze its production value.
+    let budget: u64 = args[3].parse().map_err(io::Error::other)?;
+    if !(64 * 1024 * 1024..=2 * 1024 * 1024 * 1024).contains(&budget) {
+        return Err(io::Error::other("probe reservation"));
+    }
+    // SAFETY: fd 8, when present, is the sole optional inherited thread pidfd;
+    // the helper has not opened files or created another owner for that descriptor.
+    let spawner = unsafe { boundary::inherited_spawner() };
+    boundary::arm_parent_death(app_pid, spawner.as_ref())?;
+    boundary::new_session()?;
+    let mut release = inherited(7);
+    let mut token = [0];
+    release.read_exact(&mut token)?;
+    if token != [1] {
+        return Err(io::Error::other("scope join not released"));
+    }
+    drop(release);
+    boundary::enter_namespaces(app_pid, spawner.as_ref())?;
+    drop(spawner);
+    let parent = boundary::pidfd(std::process::id(), false)?;
+    if let Some(pid) = kinewright_job_sys::fork_payload_init()? {
+        drop(parent);
+        let mut response = inherited(boundary::RESPONSE);
+        send(&mut response, 1, 1, Message::Forked { pid })?;
+        drop(response);
+        boundary::close_shim_fds()?;
+        let status = kinewright_job_sys::wait_payload_init(pid)?;
+        std::process::exit(status);
+    }
+    boundary::arm_parent_death(0, Some(&parent))?;
+    drop(parent);
+    let command = Arc::new(inherited(boundary::COMMAND));
+    let mut reader = command.as_ref();
+    let mut response = inherited(boundary::RESPONSE);
+    let start = expect(&mut reader, |message| {
+        matches!(message, Message::EnterBoundary {})
+    })?;
+    // No source reads or parser calls have occurred before resource join and
+    // namespace setup. Prime runtime CPU detection before the filesystem disappears.
+    ffmpeg_next::init().map_err(io::Error::other)?;
+    ffmpeg_next::log::set_level(ffmpeg_next::log::Level::Quiet);
+    // SAFETY: CPU feature/count queries read runtime configuration only. The
+    // process-global native allocation ceiling is initialized before any parser.
+    unsafe {
+        ffmpeg_next::ffi::av_get_cpu_flags();
+        ffmpeg_next::ffi::av_cpu_count();
+        ffmpeg_next::ffi::av_max_alloc(
+            usize::try_from((budget / 2).min(256 * 1024 * 1024)).map_err(io::Error::other)?,
+        );
+    }
+    if std::fs::read_dir("/proc/self/task")?.count() != 1 {
+        return Err(io::Error::other("media runtime created bootstrap threads"));
+    }
+    boundary::close_inventory()?;
+    boundary::empty_root(&root)?;
+    boundary::limits(budget)?;
+    let landlock = boundary::landlock();
+    let active = Arc::new(AtomicBool::new(false));
+    let cancel = Arc::new(AtomicBool::new(false));
+    let control = Arc::clone(&command);
+    let monitoring = Arc::clone(&active);
+    let interrupt = Arc::clone(&cancel);
+    let request_id = start.request;
+    let generation = start.generation;
+    let _watchdog = std::thread::Builder::new()
+        .stack_size(512 * 1024)
+        .spawn(move || {
+            loop {
+                match boundary::watchdog_poll(monitoring.load(Ordering::Acquire)) {
+                    Ok(true) => match read_frame(&mut control.as_ref()) {
+                        Ok(frame)
+                            if frame.request == request_id
+                                && frame.generation == generation
+                                && matches!(
+                                    frame.message,
+                                    Message::Cancel {} | Message::Close {}
+                                ) =>
+                        {
+                            interrupt.store(true, Ordering::Release);
+                        }
+                        _ => boundary::exit_helper(125),
+                    },
+                    Ok(false) => {}
+                    Err(_) => boundary::exit_helper(125),
+                }
+            }
+        })?;
+    boundary::install_filter(mode)?;
+    send(
+        &mut response,
+        start.request,
+        start.generation,
+        Message::Boundary { landlock },
+    )?;
+    expect(&mut reader, |message| {
+        matches!(message, Message::ConfirmBoundary {})
+    })?;
+    boundary::drop_dumpable()?;
+    send(
+        &mut response,
+        start.request,
+        start.generation,
+        Message::Ready {},
+    )?;
+    let request = read_frame(&mut reader)?;
+    let Message::Probe { video, audio } = request.message else {
+        return Err(io::Error::other("probe request required"));
+    };
+    let length = boundary::source_length()?;
+    let source = inherited(boundary::SOURCE);
+    active.store(true, Ordering::Release);
+    match crate::probe::probe(source, length, [video, audio], budget, Arc::clone(&cancel)) {
+        Ok(result) => {
+            send(
+                &mut response,
+                request.request,
+                request.generation,
+                Message::ProbeResult {
+                    result: Box::new(result),
+                },
+            )?;
+            send(
+                &mut response,
+                request.request,
+                request.generation,
+                Message::Complete {},
+            )?;
+        }
+        Err(error) => send(
+            &mut response,
+            request.request,
+            request.generation,
+            Message::Failed {
+                error: if cancel.load(Ordering::Acquire) {
+                    kinewright_media_ipc::MediaSandboxError::Cancelled
+                } else {
+                    error
+                },
+            },
+        )?,
+    }
+    Ok(())
+}
diff --git 1/crates/kinewright-media-helper/src/main.rs 2/crates/kinewright-media-helper/src/main.rs
