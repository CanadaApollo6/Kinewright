+        "mmap_anon_source",
+        "mprotect_exec",
+        "pkey_mprotect_exec",
+        "madvise_other",
+        "futex_requeue",
+        "futex_wake_bitset",
+        "futex_bad_mask",
+        "futex_high_op",
+        "tgkill_other",
+        "clone_flags",
+        "prctl_dumpable",
+        "prctl_other",
+    ] {
+        let denied = child(case, false);
+        assert_eq!(
+            denied.status.signal(),
+            Some(libc::SIGSYS),
+            "{case}: {denied:?}"
+        );
+        let control = child(case, true);
+        assert!(
+            control.status.success(),
+            "negative control {case}: {control:?}"
+        );
+    }
+}
