+            [(1 << 32) | SOURCE.cast_unsigned() as u64, 0, 0, 0, 0, 0],
+        ),
+        "pread_lifetime" => (
+            libc::SYS_pread64,
+            [LIFETIME.cast_unsigned().into(), 0, 0, 0, 0, 0],
+        ),
+        "seek_response" => (
+            libc::SYS_lseek,
+            [RESPONSE.cast_unsigned().into(), 0, 0, 0, 0, 0],
+        ),
+        "write_source" => (
+            libc::SYS_write,
+            [SOURCE.cast_unsigned().into(), 0, 0, 0, 0, 0],
+        ),
+        "writev_command" => (
+            libc::SYS_writev,
+            [COMMAND.cast_unsigned().into(), 0, 0, 0, 0, 0],
+        ),
+        "close_stderr" => (libc::SYS_close, [2, 0, 0, 0, 0, 0]),
+        "fstat_lifetime" => (
+            libc::SYS_fstat,
+            [LIFETIME.cast_unsigned().into(), 0, 0, 0, 0, 0],
+        ),
+        "mmap_source" => (
