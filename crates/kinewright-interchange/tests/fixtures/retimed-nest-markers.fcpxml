<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.13">
  <resources>
    <format id="fmt" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="a" name="a" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/a.mov"/></asset><media id="compound"><sequence format="fmt"><spine><asset-clip ref="a" offset="0s" duration="4s"><marker start="2s" value="Inner"/></asset-clip></spine></sequence></media>
  </resources>
  <library><event name="Cuts"><project name="retimed-nest-markers">
    <sequence format="fmt" >
      <spine>
        <ref-clip ref="compound" offset="4s" start="0s" duration="2s">
   <timeMap><timept time="0s" value="0s"/><timept time="2s" value="4s"/></timeMap>
   <marker start="2s" value="Container"/>
 </ref-clip>
      </spine>
    </sequence>
  </project></event></library>
</fcpxml>
