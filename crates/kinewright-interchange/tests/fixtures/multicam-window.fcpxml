<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.13">
  <resources>
    <format id="fmt" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="a" name="a" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/a.mov"/></asset><asset id="b" name="b" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/b.mov"/></asset><media id="angles"><multicam><mc-angle angleID="a" name="Wide"><asset-clip ref="a" offset="0s" duration="4s"/></mc-angle><mc-angle angleID="b" name="Close"><asset-clip ref="b" offset="0s" duration="4s"/></mc-angle></multicam></media>
  </resources>
  <library><event name="Cuts"><project name="multicam-window">
    <sequence format="fmt" >
      <spine>
        <mc-clip ref="angles" start="1s" duration="1s"><mc-source angleID="b" srcEnable="all"/></mc-clip>
      </spine>
    </sequence>
  </project></event></library>
</fcpxml>
