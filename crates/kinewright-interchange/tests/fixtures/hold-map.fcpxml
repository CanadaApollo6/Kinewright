<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.13">
  <resources>
    <format id="fmt" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="a" name="a" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/a.mov"/></asset><asset id="b" name="b" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/b.mov"/></asset>
  </resources>
  <library><event name="Cuts"><project name="hold-map">
    <sequence format="fmt" >
      <spine>
        <asset-clip ref="a" offset="0s" duration="3s"><timeMap>
    <timept time="0s" value="1s"/><timept time="3s" value="1s"/>
 </timeMap></asset-clip>
      </spine>
    </sequence>
  </project></event></library>
</fcpxml>
