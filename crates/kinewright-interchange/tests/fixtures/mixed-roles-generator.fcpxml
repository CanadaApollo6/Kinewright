<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.13">
  <resources>
    <format id="fmt" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="a" name="a" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/a.mov"/></asset><asset id="b" name="b" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/b.mov"/></asset>
  </resources>
  <library><event name="Cuts"><project name="mixed-roles-generator">
    <sequence format="fmt" >
      <spine>
        <asset-clip ref="a" offset="0s" duration="1s" videoRole="video.live"/>
 <video name="Generator" offset="1s" duration="1s"/>
 <asset-clip ref="b" offset="2s" duration="1s" videoRole="video.archive"/>
      </spine>
    </sequence>
  </project></event></library>
</fcpxml>
