<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.13">
  <resources>
    <format id="fmt" frameDuration="1/25s" width="1920" height="1080"/>
    <asset id="a" name="a" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/a.mov"/></asset><asset id="b" name="b" format="fmt" start="0s" duration="180s" ><media-rep kind="original-media" src="file:///media/b.mov"/></asset><effect id="ef" name="Glow"/>
  </resources>
  <library><event name="Cuts"><project name="nonmonotonic-nest">
    <sequence format="fmt" >
      <spine>
        <sync-clip offset="0s" duration="2s"><timeMap>
   <timept time="0s" value="0s"/><timept time="1s" value="2s"/><timept time="2s" value="1s"/>
 </timeMap><spine><asset-clip ref="a" offset="0s" duration="2s"><filter-video ref="ef"/></asset-clip></spine></sync-clip>
 <asset-clip ref="b" offset="2s" duration="1s"/>
      </spine>
    </sequence>
  </project></event></library>
</fcpxml>
