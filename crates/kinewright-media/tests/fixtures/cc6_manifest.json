  "measured_behaviour": {
    "dither": "libswscale 9.1.100 applies a deterministic 8x8 ordered dither with 64 threshold levels on 16->8-bit RGB->YUV and none on 16->10-bit. A flat 8-bit delivery patch legitimately produces two adjacent Y codes in a fixed 8x8 tiling; 251 of 256 flat grey tiles come out non-flat at 8 bits, 0 of 256 at 10. DELIVERY_DITHER_OPTION does not exist.",
    "inert_options": [
      "sws_dither=none",
      "sws_dither=bayer",
      "sws_dither=ed",
      "sws_dither=a_dither",
      "sws_dither=x_dither",
      "accurate_rnd"
    ],
    "scaler": {
      "chosen": "bicubic",
      "comparison": [
        {
          "flags": "bicubic",
          "max_code": 3,
          "p99_code": 2.0,
          "mad_code": 0.2693,
          "psnr_db": 53.486
        },
        {
          "flags": "lanczos",
          "max_code": 4,
          "p99_code": 2.0,
          "mad_code": 0.3778,
          "psnr_db": 51.367
        },
        {
          "flags": "spline",
          "max_code": 3,
          "p99_code": 2.0,
          "mad_code": 0.3038,
          "psnr_db": 52.674
        }
      ]
    },
    "decode_flags_rule": "Verification decodes through the crate's own managed decoder (flags=bicubic with explicit in/out matrix and range) and must not add full_chroma_int: bicubic and bicubic+accurate_rnd both measure max 70 / P99 2.0 / MAD 0.3753 / 43.560 dB, while adding full_chroma_int costs 63 codes on max and 5 dB. bilinear+accurate_rnd+full_chroma_int is broken in this build (max 255, 14.008 dB) and is recorded, not worked around.",
    "ten_bit_profile_option": "profile=high10 is not set: the pixel format selects it and the output is byte-identical either way."
  },
